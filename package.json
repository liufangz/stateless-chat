{
  "name": "stateless-chat",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,worker -c blue,green \"npm run dev:gateway\" \"npm run dev:worker\"",
    "dev:gateway": "npm run dev -w packages/gateway",
    "dev:worker": "npm run dev -w packages/worker",
    "infra:up": "docker-compose up -d && node scripts/wait-for-infra.js",
    "infra:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
